############.       executive_dashboard_summary   ##########\
\
SELECT\
    COUNT(*) AS total_patients,\
\
    ROUND(\
        COUNT(CASE WHEN readmitted <> 'NO' THEN 1 END) * 100.0\
        / COUNT(*),\
        2\
    ) AS readmission_rate_pct,\
\
    ROUND(AVG(num_lab_procedures), 2) AS avg_lab_tests,\
\
    ROUND(AVG(num_medications), 2) AS avg_medications,\
\
    SUM(number_emergency) AS total_emergency_visits,\
\
    COUNT(CASE WHEN diabetesMed = 'Yes' THEN 1 END)\
        AS diabetes_med_users\
\
FROM "diabetic_data.csv";\
